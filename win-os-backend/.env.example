# Copie pra .env e preencha antes de rodar de verdade (Partes 2-4).
# .env nunca deve ser commitado — já está no .gitignore.

# Supabase — projeto próprio do Win OS (separado do Broker Ads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Hotmart — token de validação do webhook (Hottok), gerado no painel da Hotmart
HOTMART_HOTTOK=

# GitHub — Personal Access Token com acesso de leitura ao repo privado soulimajr/win-os
GITHUB_PAT=
GITHUB_REPO=soulimajr/win-os

# Chave Fernet pra criptografar a API key da IA do cliente em repouso
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
